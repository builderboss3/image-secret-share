# Required — used as JWT signing key AND steganography platform key
# IMPORTANT: never change this after deployment or old messages won't decode
SESSION_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# Required — the password to access the Phantom dashboard and compose page
# Set this to anything you want. Share it only with people you trust.
DASHBOARD_PASSCODE=my_secret_code_here

# Required — PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/phantom

# Optional — port the API server listens on (Railway sets this automatically)
PORT=8080
